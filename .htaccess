# index.html lets a self-contained folder (like a toybox app) be its own clean URL: /toybox/<app>/
DirectoryIndex index.php index.html
ErrorDocument 404 /notfound.php

Options -Indexes
RewriteEngine On

# Redirect a folder's /index.html -> the folder itself (/toybox/<app>/index.html -> /toybox/<app>/)
RewriteCond %{THE_REQUEST} \s/+(.+/)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Redirect /page.html or /page.php -> /page (canonical URL, avoids duplicate-content URLs)
# (skip index pages, which their folder already serves via DirectoryIndex)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.(?:html|php)[\s?] [NC]
RewriteCond %1 !(^|/)index$ [NC]
RewriteRule ^ /%1 [R=301,L]

# Staging only: every top-level page goes through the members-only gate first.
# (The main site never matches this, because its address doesn't start with "staging.")
RewriteCond %{HTTP_HOST} ^staging\. [NC]
RewriteRule ^([A-Za-z0-9_-]+\.html)$ /php/pd_staging_page.php?f=$1 [L,QSA]

# Tracked social redirects (/discord -> discord.gg, etc). Keep in sync with PD_LINKS in php/pd_go.php.
RewriteRule ^(discord|twitch|youtube|github|steam|x)/?$ /php/pd_go.php?to=$1 [L,QSA]

# Serve page.html or page.php when /page is requested, without changing the visible URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

<Files "pd_main.html">
    Require all denied
</Files>

<IfModule mod_headers.c>
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</IfModule>

<FilesMatch "\.(mp3|wav|png|jpg|ttf|otf)$">
    Header unset Cache-Control
    Header unset Pragma
    Header unset Expires
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch>